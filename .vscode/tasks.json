{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "verify",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/verify.sh",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/dotnet.sh",
      "args": ["build", "FangcunCardClub.sln"],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "open-godot",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/godot.sh",
      "args": ["--editor", "--path", "${workspaceFolder}"],
      "problemMatcher": []
    }
  ]
}
